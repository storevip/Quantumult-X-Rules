host, openaicom-api-bdcpf8c6d2e9atf6.z01.azurefd.net, AI
host, openaicomproductionae4b.blob.core.windows.net, AI
host, production-openaicom-storage.azureedge.net, AI
host-keyword, chatgpt-async-webps-prod, AI

